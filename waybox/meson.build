  geometry_src,
  mousebind_src,
  placement_src,
  applications_src,
  decor_mode_src,
  frame_src,
  titlebar_draw_src,
  stall_src,
  icon_src,
  keychain_src,
  theme_src,
  widget_src,
  animation_src,
  style_src,
  menu_src,
  app_menu_src,
  session_store_src,
  desktops_src,
  edge_tiling_src,
  client_menu_src,
  security_src,
  output_rules_src,
  startup_src,
  json_src,
  xml_strict_src,
  render_src,
  files(
    'action_xml.cpp',
    'conditions.cpp',
    'config.cpp',
    'cursor.cpp',
    'decoration.cpp',
    'desktop_popup.cpp',
    'frame_view.cpp',
    'icon_loader.cpp',
    'idle.cpp',
    'startup_supervisor.cpp',
    'shortcuts_inhibit.cpp',
    'ipc.cpp',
    'fixes.cpp',
    'toplevel_drag.cpp',
    'xdg_session.cpp',
    'bell.cpp',
    'color_pick.cpp',
    'bell_style.cpp',
    'stall_watch.cpp',
    'script.cpp',
    'input_method.cpp',
    'layer_shell.cpp',
    'main.cpp',
    'menu_parse.cpp',
    'menu_widget.cpp',
    'output.cpp',
    'pointer_constraints.cpp',
    'sandbox.cpp',
    'scene_buffer.cpp',
    'seat.cpp',
    'server.cpp',
    'session_lock.cpp',
    'switcher_widget.cpp',
    'view.cpp',
    'workspace.cpp',
    'window_icon.cpp',
    'xdg_shell.cpp',
    'xwayland.cpp',
  ),
  ]

wb_dep = [
  cairo,
  libevdev,
  libinput,
  libxml2,
  pango,
  pangocairo,
  rsvg,
  lua,
  wayland_server,
  wlroots,
  xkbcommon,
  ]

wb_version_h = vcs_tag(
  command: wb_version_cmd,
  fallback: meson.project_version(),
  input: version_in,
  output: 'version.h',
  replace_string: '@WB_VERSION@',
)

waybox_exe = executable(
  'waybox',
  [wb_src, wb_version_h],
  include_directories: [inc_dir],
  dependencies: [wb_dep, wlr_protos],
  install: true,
  install_dir: get_option('prefix') / get_option('libexecdir'),
  link_args: ['-Wl,-lm'],
  )
