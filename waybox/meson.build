wb_src = [
  action_src,
  window_cycle_src,
  geometry_src,
  mousebind_src,
  placement_src,
  applications_src,
  decor_mode_src,
  frame_src,
  icon_src,
  keychain_src,
  theme_src,
  widget_src,
  animation_src,
  style_src,
  menu_src,
  desktops_src,
  edge_tiling_src,
  client_menu_src,
  security_src,
  output_rules_src,
  startup_src,
  xml_strict_src,
  render_src,
  files(
    'action_xml.cpp',
    'config.cpp',
    'cursor.cpp',
    'decoration.cpp',
    'desktop_popup.cpp',
    'frame_view.cpp',
    'icon_loader.cpp',
    'idle.cpp',
    'startup_supervisor.cpp',
    'input_method.cpp',
    'layer_shell.cpp',
    'main.cpp',
    'menu_parse.cpp',
    'menu_widget.cpp',
    'output.cpp',
    'pointer_constraints.cpp',
    'sandbox.cpp',
    'scene_buffer.cpp',
    'seat.cpp',
    'server.cpp',
    'session_lock.cpp',
    'switcher_widget.cpp',
    'view.cpp',
    'workspace.cpp',
    'window_icon.cpp',
    'xdg_shell.cpp',
    'xwayland.cpp',
  ),
  ]

wb_dep = [
  cairo,
  libevdev,
  libinput,
  libxml2,
  pango,
  pangocairo,
  rsvg,
  wayland_server,
  wlroots,
  xkbcommon,
  ]

waybox_exe = executable(
  'waybox',
  wb_src,
  include_directories: [inc_dir],
  dependencies: [wb_dep, wlr_protos],
  install: true,
  install_dir: get_option('prefix') / get_option('libexecdir'),
  link_args: ['-Wl,-lm'],
  )
