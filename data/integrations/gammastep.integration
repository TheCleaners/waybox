[Integration]
Name=Gammastep
Category=NightLight
Provides=night-light
Comment=Warmer screen colors after sunset
Exec=gammastep -l 51.5:-0.1
Version=gammastep -V

[Option location]
Label=Location (latitude:longitude)
Flag=-l
Hint=51.5:-0.1

[Option temperatures]
Label=Temperatures (day:night, K)
Flag=-t
Hint=6500:4000
