[Integration]
Name=swaybg
Category=Wallpaper
Comment=Wallpaper image or solid colour
Exec=swaybg -c '#303030'
Page=wallpaper
Version=swaybg -v

[Option image]
Label=Image
Flag=-i
Hint=~/Pictures/wallpaper.png
Type=image

[Option mode]
Label=Mode
Flag=-m
Type=choice
Choices=stretch,fill,fit,center,tile,solid_color
Default=stretch

[Option colour]
Label=Colour
Flag=-c
Hint=#303030
Type=color
