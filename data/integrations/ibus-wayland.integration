[Integration]
Name=IBus (Wayland)
Category=InputMethod
Comment=IBus speaking Wayland's input-method protocol to Waybox (needs ibus-wayland): GTK apps need no module, candidates show at the text cursor
Exec=sh -c 'ibus-daemon --replace --xim & sleep 1; exec /usr/libexec/ibus-wayland'
Binary=/usr/libexec/ibus-wayland
Kind=inputmethod
Env=XMODIFIERS=@im=ibus
Env=QT_IM_MODULE=ibus
Env=SDL_IM_MODULE=ibus
