[Integration]
Name=IBus
Category=InputMethod
Comment=Input method framework (Chinese, Japanese, Korean, emoji with Ctrl+Shift+E), reaching apps through their GTK and Qt modules (needs ibus-gtk3 for GTK 3 apps); IBus (Wayland) is the better choice when ibus-wayland is installed
Exec=ibus-daemon --replace --xim
Binary=ibus-daemon
Kind=inputmethod
Env=XMODIFIERS=@im=ibus
Env=GTK_IM_MODULE=ibus
Env=QT_IM_MODULE=ibus
Env=SDL_IM_MODULE=ibus
