#
# These things are run when a Waybox Wayland session is started.
# Copy to $XDG_CONFIG_HOME/waybox/autostart to customize.
#

#
# Change from Openbox: the desktop environment's config tools should begin
# through autostart elements (e.g. /etc/xdg/autostart); there's no need to
# specify them here.
#


# Update the DBus environment
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

# Desktop portals (screenshots, screen sharing) choose their backends from
# XDG_CURRENT_DESKTOP when they start. Restart one still running from another
# desktop session, so it serves Waybox; nothing happens if none is running.
command -v systemctl >/dev/null 2>&1 &&
	systemctl --user try-restart xdg-desktop-portal.service 2>/dev/null

# Start a dock
cairo-dock &

# Start a panel
(waybar || yambar) &

# Start a notification daemon
mako &

# Start a polkit authentication agent: it asks for your password when a
# program needs more privileges (mounting a drive, changing system
# settings). Each desktop's agent autostarts only in that desktop, so start
# the first one installed.
start_polkit_agent()
{
    for agent in \
        /usr/lib/*/libexec/polkit-kde-authentication-agent-1 \
        /usr/libexec/polkit-kde-authentication-agent-1 \
        /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
        /usr/libexec/polkit-gnome-authentication-agent-1 \
        /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
        /usr/libexec/polkit-mate-authentication-agent-1 \
        /usr/lib/mate-polkit/polkit-mate-authentication-agent-1 \
        /usr/libexec/xfce-polkit \
        lxqt-policykit-agent lxpolkit soteria
    do
        if command -v "$agent" >/dev/null 2>&1; then
            "$agent" &
            return
        fi
    done
}
start_polkit_agent

# To switch the screens off after 10 minutes without input, and back on at
# the next key press or mouse move, uncomment this (needs swayidle and
# wlopm). To lock the screen as well, add for example: timeout 300 'swaylock -f'
#swayidle -w timeout 600 'wlopm --off "*"' resume 'wlopm --on "*"' &

# A wallpaper: a random one from the wallpapers folders, with whichever of
# swaybg, hyprpaper or wpaperd is installed (see waybox-wallpaper -h; or
# turn it off here and start it from wbconf's Integrations instead).
command -v waybox-wallpaper >/dev/null 2>&1 && waybox-wallpaper &

