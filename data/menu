#!/usr/bin/env python3
"""Show Waybox's menu.xml in rofi (rofi -show menu -modes menu:waybox-menu)."""

import json
import os
import shlex
import subprocess
import sys
import xml.dom.minidom as dom
import xml.parsers.expat


def waybox_pid():
    # Set by waybox for its children (pgrep would also find the session's
    # shell wrapper). None when not running under waybox.
    pid = os.getenv('WAYBOX_PID', '')
    return int(pid) if pid.isdigit() and int(pid) > 1 else None


def clean(text):
    # rofi's row separators can't appear in a field.
    return text.replace('\0', '').replace('\x1f', '')


def row(text, info, **fields):
    extra = ''.join('\x1f%s\x1f%s' % (k, clean(v)) for k, v in fields.items())
    print('%s\0info\x1f%s%s' % (clean(text), clean(json.dumps(info)), extra))


def text_of(node):
    return ''.join(c.nodeValue for c in node.childNodes
                   if c.nodeType in (c.TEXT_NODE, c.CDATA_SECTION_NODE)).strip()


def item_command(item):
    actions = item.getElementsByTagName('action')
    if not actions:
        return None
    name = actions[0].getAttribute('name')
    if name == 'Execute':
        for tag in ('execute', 'command'):
            nodes = actions[0].getElementsByTagName(tag)
            if nodes and text_of(nodes[0]):
                return text_of(nodes[0])
        return None
    pid = waybox_pid()
    if pid is None:
        return None
    if name == 'Exit':
        return 'kill -s TERM %d' % pid
    if name == 'Reconfigure':
        return 'kill -s USR2 %d' % pid
    return None


def get_menu_items(menu, indent, expand):
    menu_id = menu.getAttribute('id')
    label = menu.getAttribute('label').replace('_', '') or menu_id
    row('%s%s ⇢' % (indent, label), {'menu': menu_id},
        nonselectable=str(menu_id == '').lower())
    indent += ' '
    if not expand:
        return
    for child in menu.childNodes:
        if child.nodeType != child.ELEMENT_NODE:
            continue
        if child.tagName == 'item':
            cmd = item_command(child)
            if cmd is None:
                continue
            label = child.getAttribute('label').replace('_', '')
            row(cmd, {'exec': cmd}, icon=child.getAttribute('icon'),
                display='%s %s' % (indent, label))
        elif child.tagName == 'menu':
            if child.getAttribute('execute') == '':
                get_menu_items(child, indent, os.getenv('ROFI_RETV') is None)
                continue
            # A pipe menu: a broken or missing script mustn't stop the menu.
            try:
                out = subprocess.run(shlex.split(child.getAttribute('execute')),
                                     capture_output=True, timeout=10).stdout
                for m in dom.parseString(out).getElementsByTagName('menu'):
                    get_menu_items(m, indent, True)
            except (OSError, ValueError, subprocess.SubprocessError,
                    xml.parsers.expat.ExpatError):
                pass


menu_xml = os.getenv('WB_MENU_XML') or 'menu.xml'
document = dom.parse(menu_xml)

print('\0message\x1f%s' % clean(os.path.abspath(menu_xml)))
info = os.getenv('ROFI_INFO')
if info is not None:
    try:
        obj = json.loads(info)
    except ValueError:
        obj = {}
    if 'exec' in obj:
        # Detach: the program outlives this script and rofi.
        subprocess.Popen(shlex.split(obj['exec']), stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        sys.exit(0)
    elif 'menu' in obj:
        for menu in document.getElementsByTagName('menu'):
            if menu.getAttribute('id') == obj['menu']:
                get_menu_items(menu, '', True)
                print('---\0nonselectable\x1ftrue')
                break

root_menu = document.getElementsByTagName('menu')[0]
get_menu_items(root_menu, '', True)
